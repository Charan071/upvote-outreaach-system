# Copy to .env and fill in values from https://dashboard.unipile.com

# Local Postgres: docker compose up -d
DATABASE_URL="postgresql://outreach:outreach@localhost:5432/outreach"

UNIPILE_DSN=https://apiXX.unipile.com:PORT
UNIPILE_TOKEN=
UNIPILE_ACCOUNT_ID=

# Optional. Inbound classification skipped if empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Server-only. Search-only. Daily collect uses 1 credit.
CONTEXT_DEV_API_KEY=
CONTEXT_DEV_DAILY_CREDIT_BUDGET=1

# Optional. Poll interval for the background queue worker (ms). Spacing between sends uses min/max gap in Settings.
# QUEUE_WORKER_INTERVAL_MS=20000
# DISABLE_QUEUE_WORKER=1
